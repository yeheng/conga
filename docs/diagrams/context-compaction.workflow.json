    { "id": "e-nousage", "from": "check", "to": "bycount", "label": "无 usage 数据", "role": "branch", "variant": "dashed", "fromSide": "bottom", "toSide": "top", "labelDy": 30 },
    { "id": "e-share", "from": "bycount", "to": "keep", "label": "同一贪心算法", "role": "main", "fromSide": "right", "toSide": "bottom", "labelDy": 26 }
