    { "id": "check", "lane": "host", "col": 3, "type": "backend", "label": "预算判定", "sublabel": "ContextBudget" },
    { "id": "keep", "lane": "host", "col": 5, "type": "backend", "label": "压缩后喂 LLM", "sublabel": "贪心保留 · 前置提示", "tag": "留至 50%" },
