  "cards": [
    {
      "dot": "emerald",
      "title": "日志只追加,压缩以检查点追加",
      "items": [
        "events.jsonl 永远 append-only:压缩只追加一条 Compacted 检查点,已有行不改",
        "无 LLM 摘要:丢弃最旧整组 + 一条前置提示,不调模型",
        "usage 随 Assistant 事件持久化,预算跨重启存活"
      ]
    },
    {
      "dot": "cyan",
      "title": "一套算法,两个触发器",
      "items": [
        "token 感知为主:超 window 的 80% 触发,压到 50%",
        "80% → 50% 的滞后带避免阈值附近反复压缩",
        "无 usage 时按条数兜底,复用同一 compact_by_count"
      ]
    },
    {
      "dot": "rose",
      "title": "协议安全",
      "items": [
        "原子组保证 Assistant(tool_call) 永不与 ToolResult 分离",
        "孤儿 tool_result 会触发 provider 协议错误,原子组从结构上杜绝",
        "无 tokenizer:不假装建模 per-message token 成本"
      ]
    }
  ]
